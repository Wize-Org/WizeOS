+package com.android.server.pm;
+
+import android.app.ActivityThread;
+import android.content.Context;
+import android.provider.Settings;
+
+/** Reads Settings.Global-backed installation signature verification controls. */
+final class InstallSignatureVerificationSettings {
+    static final String SETTING_ALLOW_DOWNGRADE =
+            "install_sig_verification_allow_downgrade";
+    static final String SETTING_DISABLE_DIGEST_VERIFY =
+            "install_sig_verification_disable_digest_verify";
+    static final String SETTING_DISABLE_SIGNATURE_COMPARISON =
+            "install_sig_verification_disable_signature_comparison";
+    static final String SETTING_DISABLE_EXACT_SIGNATURE_MATCH =
+            "install_sig_verification_disable_exact_signature_match";
+    static final String SETTING_USE_INSTALLED_SIGNATURES =
+            "install_sig_verification_use_installed_signatures";
+    static final String SETTING_BYPASS_BLOCK =
+            "install_sig_verification_bypass_block";
+    static final String SETTING_BYPASS_SHARED_USER_VERIFY =
+            "install_sig_verification_bypass_shared_user_verify";
+    static final String SETTING_DISABLE_PACKAGE_VERIFICATION_AGENT =
+            "install_sig_verification_disable_package_verification_agent";
+
+    private InstallSignatureVerificationSettings() {
+    }
+
+    static boolean isAllowDowngradeEnabled() {
+        return isEnabled(SETTING_ALLOW_DOWNGRADE);
+    }
+
+    static boolean isDisableDigestVerifyEnabled(Context context) {
+        return isEnabled(context, SETTING_DISABLE_DIGEST_VERIFY);
+    }
+
+    static boolean isDisableSignatureComparisonEnabled() {
+        return isEnabled(SETTING_DISABLE_SIGNATURE_COMPARISON);
+    }
+
+    static boolean isDisableSignatureComparisonEnabled(Context context) {
+        return isEnabled(context, SETTING_DISABLE_SIGNATURE_COMPARISON);
+    }
+
+    static boolean isDisableExactSignatureMatchEnabled(Context context) {
+        return isEnabled(context, SETTING_DISABLE_EXACT_SIGNATURE_MATCH);
+    }
+
+    static boolean isUseInstalledSignaturesEnabled() {
+        return isEnabled(SETTING_USE_INSTALLED_SIGNATURES);
+    }
+
+    static boolean isUseInstalledSignaturesEnabled(Context context) {
+        return isEnabled(context, SETTING_USE_INSTALLED_SIGNATURES);
+    }
+
+    static boolean isBypassSharedUserVerifyEnabled() {
+        return isEnabled(SETTING_BYPASS_SHARED_USER_VERIFY);
+    }
+
+    static boolean isDisablePackageVerificationAgentEnabled(Context context) {
+        return isEnabled(context, SETTING_DISABLE_PACKAGE_VERIFICATION_AGENT);
+    }
+
+    static boolean isBypassBlockEnabled(Context context) {
+        return isEnabled(context, SETTING_BYPASS_BLOCK);
+    }
+
+    private static boolean isEnabled(String key) {
+        Context context = ActivityThread.currentApplication();
+        return context != null && isEnabled(context, key);
+    }
+
+    private static boolean isEnabled(Context context, String key) {
+        return Settings.Global.getInt(context.getContentResolver(), key, 0) != 0;
+    }
+}
