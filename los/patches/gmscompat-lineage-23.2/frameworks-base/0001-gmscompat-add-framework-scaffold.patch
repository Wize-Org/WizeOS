+package android.app.compat.gms;
+
+import android.app.ActivityThread;
+import android.compat.annotation.ChangeId;
+import android.compat.annotation.Disabled;
+import android.content.pm.ApplicationInfo;
+
+import com.android.internal.gmscompat.GmsInfo;
+
+/**
+ * Minimal framework-side GmsCompat entry point.
+ *
+ * @hide
+ */
+public final class GmsCompat {
+    /**
+     * Compatibility change used to enable unprivileged GMS framework shims.
+     *
+     * @hide
+     */
+    @ChangeId
+    @Disabled
+    public static final long GMS_UNPRIVILEGED_COMPAT = 1531297613045645771L;
+
+    private GmsCompat() {}
+
+    /**
+     * Returns whether the current process belongs to a known GMS package.
+     *
+     * TODO: replace this process-name check with current GrapheneOS-style
+     * package/signature validation and CompatChange integration.
+     *
+     * @hide
+     */
+    public static boolean isEnabled() {
+        final String packageName = ActivityThread.currentPackageName();
+        return isKnownGmsPackage(packageName);
+    }
+
+    /**
+     * Returns whether the GMS compatibility change should be force-enabled for
+     * an unprivileged known GMS package.
+     *
+     * @hide
+     */
+    public static boolean isChangeEnabled(long changeId, ApplicationInfo app) {
+        if (changeId != GMS_UNPRIVILEGED_COMPAT || app == null) {
+            return false;
+        }
+
+        // Privileged / bundled GMS should not need the unprivileged compatibility layer.
+        if (app.isPrivilegedApp()) {
+            return false;
+        }
+
+        return isKnownGmsPackage(app.packageName);
+    }
+
+    /** @hide */
+    public static boolean isKnownGmsPackage(String packageName) {
+        return GmsInfo.PACKAGE_GMS.equals(packageName)
+                || GmsInfo.PACKAGE_GSF.equals(packageName)
+                || GmsInfo.PACKAGE_PLAY_STORE.equals(packageName);
+    }
+}
