+package com.android.internal.gmscompat;
+
+import android.app.Service;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+
+/**
+ * Internal no-op hook surface for the fresh GmsCompat port.
+ *
+ * Keep this class small and add real behavior in focused commits.
+ *
+ * @hide
+ */
+public final class GmsHooks {
+    private GmsHooks() {}
+
+    /** @hide */
+    public static void attachService(Service service) {
+        // TODO: foreground-service keepalive compatibility.
+    }
+
+    /** @hide */
+    public static ComponentName startService(Context context, Intent service) {
+        // TODO: route selected GMS service starts through the compatibility layer.
+        return context.startService(service);
+    }
+
+    /** @hide */
+    public static int getCurrentUser() {
+        // TODO: secondary-user support for GMS clients.
+        return android.app.ActivityManager.getCurrentUser();
