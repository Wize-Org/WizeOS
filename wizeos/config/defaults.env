ACTION="${ACTION:-all}"
DEVICE="${DEVICE:-mustang}"
TAG="${TAG:-2026062800}"
BUILD_NUMBER="${BUILD_NUMBER:-${TAG}}"
BUILD_USER="${BUILD_USER:-builder}"
BASE_DIR="${BASE_DIR:-/home/${BUILD_USER}/android}"
WORKDIR="${WORKDIR:-${BASE_DIR}/grapheneos-${TAG}}"
JOBS="${JOBS:-24}"
SYNC_JOBS="${SYNC_JOBS:-8}"
START_OVER="${START_OVER:-0}"
CLEAN_OUT="${CLEAN_OUT:-1}"
SIGNED="${SIGNED:-1}"
WIZEOS_PROFILE="${WIZEOS_PROFILE:-balanced}"
ROOT="${ROOT:-none}"
MAGISK_APK="${MAGISK_APK:-}"
MAGISK_PREINIT_DEVICE="${MAGISK_PREINIT_DEVICE:-metadata}"
AVBROOT="${AVBROOT:-avbroot}"
AVBROOT_AUTO_INSTALL="${AVBROOT_AUTO_INSTALL:-1}"
AVBROOT_VERSION="${AVBROOT_VERSION:-latest}"
AVBROOT_INSTALL_PATH="${AVBROOT_INSTALL_PATH:-/usr/local/bin/avbroot}"
AVBROOT_AVB_KEY="${AVBROOT_AVB_KEY:-}"
AVBROOT_OTA_KEY="${AVBROOT_OTA_KEY:-}"
AVBROOT_OTA_CERT="${AVBROOT_OTA_CERT:-}"
AVBROOT_PASS_AVB_FILE="${AVBROOT_PASS_AVB_FILE:-}"
AVBROOT_PASS_OTA_FILE="${AVBROOT_PASS_OTA_FILE:-}"
KEYS_SOURCE="${KEYS_SOURCE:-/root/wizeos-keys}"
SIGNING_KEY_PASSPHRASE_FILE="${SIGNING_KEY_PASSPHRASE_FILE:-/home/${BUILD_USER}/wizeos-secrets/signing-empty.pass}"
UPDATE_SERVER="${UPDATE_SERVER:-https://www.wizesoft.me/download/${DEVICE}/}"
OFFICIAL_BUILD="${OFFICIAL_BUILD:-true}"
LSPOSED_COMPAT="${LSPOSED_COMPAT:-0}"
PATCHES_DIR="${PATCHES_DIR:-${SCRIPT_DIR}/patches}"
BUILDER_PATCHES_DIR="${BUILDER_PATCHES_DIR:-/home/${BUILD_USER}/wizeos-patches}"
WIZEOS_PROFILE_PATCHES_DIR="${WIZEOS_PROFILE_PATCHES_DIR:-${PATCHES_DIR}/profiles/${WIZEOS_PROFILE}}"
LSPOSED_PATCHES_DIR="${LSPOSED_PATCHES_DIR:-${PATCHES_DIR}/lsposed-compat}"

# KernelSU Next source-built kernel root support.
# ROOT=ksunext selects KernelSU Next. KSU_FLAVOR is kept only as a deprecated
# compatibility variable and must remain ksunext if provided.
KSU_FLAVOR="${KSU_FLAVOR:-ksunext}"
KSU_INTEGRATION="${KSU_INTEGRATION:-setup}"
KSU_SETUP_URL="${KSU_SETUP_URL:-}"
KSU_SETUP_ARG="${KSU_SETUP_ARG:-}"
KSU_MANAGER_APK="${KSU_MANAGER_APK:-}"
KSU_ZYGISK_ZIP="${KSU_ZYGISK_ZIP:-}"
KSU_BUNDLE_MANAGER="${KSU_BUNDLE_MANAGER:-1}"
KSU_BUNDLE_ZYGISK="${KSU_BUNDLE_ZYGISK:-1}"
KSU_PATCH_KERNEL="${KSU_PATCH_KERNEL:-1}"
KSU_KERNEL_PATCH_DIR="${KSU_KERNEL_PATCH_DIR:-${PATCHES_DIR}/kernel/ksunext}"

# KernelSU Next defaults and backwards-compatible variable names.
KSUNEXT_APK="${KSUNEXT_APK:-/root/KernelSU_Next.apk}"
ZYGISK_NEXT_ZIP="${ZYGISK_NEXT_ZIP:-/root/Zygisk-Next.zip}"
KSUNEXT_BUNDLE_MANAGER="${KSUNEXT_BUNDLE_MANAGER:-${KSU_BUNDLE_MANAGER}}"
KSUNEXT_BUNDLE_ZYGISK="${KSUNEXT_BUNDLE_ZYGISK:-${KSU_BUNDLE_ZYGISK}}"
KSUNEXT_PATCH_KERNEL="${KSUNEXT_PATCH_KERNEL:-${KSU_PATCH_KERNEL}}"
KSUNEXT_INTEGRATION="${KSUNEXT_INTEGRATION:-${KSU_INTEGRATION}}"
KSUNEXT_SETUP_URL="${KSUNEXT_SETUP_URL:-https://raw.githubusercontent.com/KernelSU-Next/KernelSU-Next/dev/kernel/setup.sh}"
KSUNEXT_SETUP_ARG="${KSUNEXT_SETUP_ARG:-${KSU_SETUP_ARG}}"
KSUNEXT_KERNEL_PATCH_DIR="${KSUNEXT_KERNEL_PATCH_DIR:-${PATCHES_DIR}/kernel/ksunext}"

SUSFS_MODULE_ZIP="${SUSFS_MODULE_ZIP:-/root/susfs4ksu.zip}"
KSUNEXT_SUSFS="${KSUNEXT_SUSFS:-0}"
SUSFS_PATCH_KERNEL="${SUSFS_PATCH_KERNEL:-${KSUNEXT_SUSFS}}"
SUSFS_KERNEL_PATCH_DIR="${SUSFS_KERNEL_PATCH_DIR:-${PATCHES_DIR}/kernel/susfs}"
SUSFS_BUNDLE_MODULE="${SUSFS_BUNDLE_MODULE:-${KSUNEXT_SUSFS}}"

# GrapheneOS Pixel 10 kernel build. mustang/blazer/frankel use the muzel kernel tree.
KERNEL_BUILD="${KERNEL_BUILD:-auto}"
KERNEL_BASE_DIR="${KERNEL_BASE_DIR:-/home/${BUILD_USER}/android/kernel}"
KERNEL_REPO_URL="${KERNEL_REPO_URL:-https://gitlab.com/grapheneos/kernel_pixel_muzel.git}"
KERNEL_REPO_BRANCH="${KERNEL_REPO_BRANCH:-17}"
KERNEL_WORKDIR="${KERNEL_WORKDIR:-${KERNEL_BASE_DIR}/kernel_pixel_muzel}"
KERNEL_CODENAME="${KERNEL_CODENAME:-muzel}"
KERNEL_BUILD_SCRIPT="${KERNEL_BUILD_SCRIPT:-./build_${KERNEL_CODENAME}.sh}"
KERNEL_BUILD_ARGS="${KERNEL_BUILD_ARGS:---lto=full}"
KERNEL_OS_PREBUILT_DIR="${KERNEL_OS_PREBUILT_DIR:-device/google/laguna-kernels/6.6/grapheneos/${KERNEL_CODENAME}}"
KERNEL_DIST_DIR="${KERNEL_DIST_DIR:-out/${KERNEL_CODENAME}/dist}"
KERNEL_REPO_MANIFEST_FILE="${KERNEL_REPO_MANIFEST_FILE:-aosp_manifest.xml}"
KERNEL_CLEAN="${KERNEL_CLEAN:-0}"
GIT_USER_NAME="${GIT_USER_NAME:-WizeOS Builder}"
GIT_USER_EMAIL="${GIT_USER_EMAIL:-builder@wizeos.local}"
USE_WIZEOS_MANIFEST="${USE_WIZEOS_MANIFEST:-1}"
MANIFEST_URL="${MANIFEST_URL:-}"
MANIFEST_BRANCH="${MANIFEST_BRANCH:-}"
MANIFEST_FILE="${MANIFEST_FILE:-}"
VERIFY_MANIFEST_TAG="${VERIFY_MANIFEST_TAG:-}"
